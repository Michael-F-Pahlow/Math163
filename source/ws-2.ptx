<worksheet xml:id="ws-2">
    <title>Infinite Series</title>
    <exercise workspace="3.0in">
        <p>
            Use the integral test to determine if the following series converges or diverges.
            <md>
                \sum_{n=1}^{\infty} \frac{n}{n^2+1}\hspace{6.0in}
            </md>
        </p>
    </exercise>
    <exercise workspace="3.0in">
        <p>
            Use the integral test to determine if the following series converges or diverges.
            <md>
                \sum_{n=2}^{\infty} \frac{1}{n\ln(n)}\hspace{6.0in}
            </md>
        </p>
    </exercise>
    <exercise>
        <introduction>
        <p>
            Use the limit comparison test to determine if the following series converges or diverges. Compare each series to
            a <m>p-</m>series or geometric series
        </p>
        </introduction>
       <task workspace="1.5in">
        <statement>
            <p>
            <md>
                \sum_{n=1}^{\infty} \left(\frac{\ln(n)}{n}\right)^2 \hspace{6.0in}
            </md> 
            </p>
        </statement>
       </task>
        <task workspace="1.5in">
        <statement>
            <p>
            <md>
                \sum_{n=1}^{\infty} \frac{1}{4^n-3^n} \hspace{6.0in}
            </md> 
            </p>
        </statement>
       </task>
       <task workspace="1.5in">
        <statement>
            <p>
            <md>
                \sum_{n=1}^{\infty} \left(\frac{1}{n}-\sin\left(\frac{1}{n}\right)\right)\hspace{6.0in}
            </md> 
            </p>
        </statement>
       </task>
    </exercise>
    
</worksheet>